# The page's own checks; the root's `just ci` adds the shared ones.
ci:
    pnpm exec tsc -p .
    pnpm build

# The page, at localhost:5173.
dev:
    pnpm dev

# Builds the page and serves it at library.potentialhedge.com, from lwirth-cloud,
# whose serve.nix in dotcloud says how.
deploy: ci
    rsync -rlpt --delete --delay-updates --chmod=D755,F644 dist/ root@lwirth-cloud:/srv/library/
