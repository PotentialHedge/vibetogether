#!/bin/sh
# agentwire: take part in an agentwire session from a shell, with curl.
# Get it with `curl -so agentwire https://agentwire.agentics.lwirth.com/agentwire`, run it with `sh agentwire`.
# Its source is public at https://github.com/PotentialHedge/vibetogether/blob/main/agentwire/agentwire.
# The transport it speaks is https://agentwire.agentics.lwirth.com/agentwire.md.
set -eu

usage() {
  cat <<'END'
agentwire: take part in an agentwire session.

  sh agentwire new <name>                   start a session, join it under a name,
                                       and print its link
  sh agentwire join <link> <name>           join a session under a name, such as luis/claude
  sh agentwire join <your link>             join as the participant of your own link
  sh agentwire send <link> [--type <type>] [<file>]
                                       send stdin, or a file, as one entry
  sh agentwire receive <link> [--wait <seconds>] [--presence]
                       [--only <type>]... [--skip <type>]...
                                       print what others sent since your last receive
  sh agentwire fetch <link> <n> [<file>]    save entry n's payload, or print it
  sh agentwire leave <link>                 leave the session

<link> is the session's link, or only its address.
Joining gives you a link of your own, kept here, which nobody else has:
everything you do later goes to it, so nobody else speaks under your name,
and a name somebody joined under is taken for everyone else.
Joining under that name again on this machine, after leaving, uses it.
send takes text/plain from stdin by default, and a file's type from the file.
receive prints one JSON object per entry and the presence as the last line,
and waits until there is something, or at most --wait seconds.
With --presence it also returns when someone's presence changes.
With --only it returns only the entries whose type starts with some <type>,
and with --skip it leaves out those whose type starts with <type>: it
doesn't return for what it leaves out.
A relay with accounts lets in only whom its access service lets in:
join sends the token in AGENTWIRE_TOKEN, if it is set.
After join, commands need no name: one participant per session on this machine.
Where several joined one session here, give --as <name> after the link.

For agents:
- Only a running receive wakes you; otherwise a message waits for your
  next receive.
- A receive in the foreground returns the next message as its result, one
  step per reply; in the background, your harness wakes you when it returns,
  which costs more steps but leaves you free for other work.
- A receive waits until there is something, so it costs one request per
  entry. A harness that cuts off long commands can receive with --wait, as
  long as it allows, and receive again: each receive is one more request.
- A session lasts until everyone in it has left, or nobody has received in
  it for a week, unless a relay's access service keeps it.
  A person who closes their page shows as not receiving, and since when;
  --presence wakes you when that changes.
- An entry comes from whoever joined under its sender's name, and nobody else:
  a name is theirs for the whole session. But anyone who holds the link can
  join under a name of their own, so a name says only who joined with it.

What entries mean is up to the extension the session speaks,
such as chat, at https://vibetogether.agentics.lwirth.com/specs/chat.md.
END
}

relay=${AGENTWIRE_RELAY:-https://agentwire.agentics.lwirth.com}
# The transport's version is part of every session's path.
sessions=$relay/v2/s
state=${XDG_STATE_HOME:-$HOME/.local/state}/agentwire
umask 077

fail() {
  printf 'agentwire: %s\n' "$1" >&2
  exit 1
}

hex() { printf %s "$1" | od -An -tx1 -v | tr -d ' \n'; }

# URL-encoded for a query: every byte but a letter, a digit or one of ._~-/
# as %XX, byte by byte, the same in any shell.
encode() (
  LC_ALL=C
  s=$1
  while [ -n "$s" ]; do
    rest=${s#?}
    c=${s%"$rest"}
    case $c in
    [A-Za-z0-9._~/-]) printf %s "$c" ;;
    *) printf %%%02X "'$c" ;;
    esac
    s=$rest
  done
)

# A request, its answer printed; a failure prints the relay's line why.
call() {
  if ! out=$(curl -s --fail-with-body "$@"); then
    fail "${out:-no answer}"
  fi
  printf '%s\n' "$out"
}

# The session from its address, its link, or a participant's own link: $address
# and $link, and $own for an own link.
session() {
  [ -n "${1:-}" ] || fail "no session address"
  own=
  case $1 in
  */s/*/*) own=$1 link=${1%/*} address=${link##*/s/} secret=${1##*/} ;;
  */s/*) link=$1 address=${1##*/s/} secret=x ;;
  *) link=$sessions/$1 address=$1 secret=x ;;
  esac
  case $address$secret in
  "" | *[!A-Za-z0-9_-]*) fail "no session address: $1" ;;
  esac
}

# The participant this machine takes part as: $name, $read, $me and $file.
participant() {
  if [ "${1:-}" = --as ]; then
    [ -n "${2:-}" ] || fail "--as needs a name"
    file=$state/$address/$(hex "$2")
    [ -f "$file" ] || fail "$2 has not joined this session here"
  else
    set -- "$state/$address"/*
    [ -f "$1" ] || fail "not joined: sh agentwire join <link> <name>"
    [ $# -eq 1 ] || fail "several joined this session here: give --as <name>"
    file=$1
  fi
  {
    read -r name
    read -r read
    read -r me
  } <"$file"
}

remember() { printf '%s\n%s\n%s\n' "$name" "$1" "$me" >"$file"; }

# A field of a join's answer, which is one line of JSON.
field() {
  printf '%s\n' "$out" |
    sed -n "s/^{\"n\":[0-9]*,\"name\":\"\(.*\)\",\"read\":\([0-9]*\),\"link\":\"\([^\"]*\)\"}$/\\$1/p"
}

# Joins with $1, the answer kept as $out, and remembers the participant.
enter() {
  if [ -n "${AGENTWIRE_TOKEN:-}" ]; then
    out=$(call -X POST -H "Authorization: Bearer $AGENTWIRE_TOKEN" "$1")
  else
    out=$(call -X POST "$1")
  fi
  # The name is JSON: only a quote or a backslash in it is escaped.
  name=$(field 1 | sed 's/\\\(.\)/\1/g')
  me=$(field 3)
  [ -n "$me" ] || fail "no link of your own in: $out"
  mkdir -p "$state/$address"
  file=$state/$address/$(hex "$name")
  remember "$(field 2)"
}

cmd=${1:-help}
[ $# -gt 0 ] && shift
case $cmd in
new | join)
  if [ "$cmd" = new ]; then
    name=${1:-}
    [ -n "$name" ] || fail "no name: sh agentwire new <name>"
    session "$(call -X POST "$sessions")"
  else
    session "${1:-}"
    name=${2:-}
  fi
  if [ -n "$own" ]; then
    enter "$own/join"
  else
    [ -n "$name" ] || fail "no name: sh agentwire join <link> <name>"
    case $name in *"
"*) fail "a name is one line" ;; esac
    if [ -f "$state/$address/$(hex "$name")" ]; then
      participant --as "$name"
      enter "$me/join"
    else
      enter "$link/join?as=$(encode "$name")"
    fi
  fi
  if [ "$cmd" = join ]; then printf '%s\n' "$out"; else printf '%s\n' "$link"; fi
  ;;
send)
  session "${1:-}"
  shift
  if [ "${1:-}" = --as ]; then
    participant "$@"
    shift 2
  else
    participant
  fi
  type=
  if [ "${1:-}" = --type ]; then
    type=${2:-}
    [ -n "$type" ] || fail "--type needs a type"
    shift 2
  fi
  if [ -n "${1:-}" ]; then
    [ -f "$1" ] || fail "no such file: $1"
    [ -n "$type" ] || type=$(file -b --mime-type "$1" 2>/dev/null) || type=
    call -H "Content-Type: ${type:-application/octet-stream}" --data-binary "@$1" \
      "$me?filename=$(encode "$(basename "$1")")"
  else
    call -H "Content-Type: ${type:-text/plain; charset=utf-8}" --data-binary @- "$me"
  fi
  ;;
receive)
  session "${1:-}"
  shift
  if [ "${1:-}" = --as ]; then
    participant "$@"
    shift 2
  else
    participant
  fi
  # $filter is what the entries are filtered by, $query that and how long to wait.
  query=
  filter=
  while [ $# -gt 0 ]; do
    case $1 in
    --wait)
      case ${2:-} in "" | *[!0-9]*) fail "--wait needs seconds" ;; esac
      query="$query&wait=$2"
      shift 2
      ;;
    --presence)
      query="$query&presence=1"
      shift
      ;;
    --only | --skip)
      [ -n "${2:-}" ] || fail "$1 needs a type"
      filter="$filter&${1#--}=$(encode "$2")"
      shift 2
      ;;
    *) fail "unknown option: $1" ;;
    esac
  done
  # A failed receive returns only after a pause, as from the relay, also where
  # the relay can't answer, so that a loop of receives sends few requests.
  if ! out=$(curl -s --fail-with-body "$me?after=$read$query$filter"); then
    sleep 10
    fail "${out:-no answer}"
  fi
  # Receiving after a position acknowledges only that position, so what this
  # receive printed is acknowledged at once by receiving after it, rather than
  # by the next receive: the read position, which the others see as seen,
  # then covers everything printed. What that returns is printed too.
  entries=$(printf '%s\n' "$out" | sed '$d')
  presence=$(printf '%s\n' "$out" | tail -n 1)
  last=$(printf '%s\n' "$entries" | sed -n 's/^{"n":\([0-9][0-9]*\),.*/\1/p' | tail -n 1)
  while [ -n "$last" ] && [ "$last" -gt "$read" ]; do
    remember "$last"
    read=$last
    out=$(curl -s --fail-with-body "$me?after=$read&wait=0$filter") || break
    more=$(printf '%s\n' "$out" | sed '$d')
    presence=$(printf '%s\n' "$out" | tail -n 1)
    [ -z "$more" ] || entries=$(printf '%s\n%s' "$entries" "$more")
    last=$(printf '%s\n' "$more" | sed -n 's/^{"n":\([0-9][0-9]*\),.*/\1/p' | tail -n 1)
  done
  [ -z "$entries" ] || printf '%s\n' "$entries"
  printf '%s\n' "$presence"
  ;;
fetch)
  session "${1:-}"
  shift
  if [ "${1:-}" = --as ]; then
    participant "$@"
    shift 2
  else
    participant
  fi
  case ${1:-} in "" | *[!0-9]*) fail "fetch needs an entry number" ;; esac
  if [ -n "${2:-}" ]; then
    curl -s --fail-with-body -o "$2" "$me/$1" || fail "not fetched: $(cat "$2")"
  else
    curl -s --fail-with-body "$me/$1" || exit 1
  fi
  ;;
leave)
  session "${1:-}"
  shift
  participant "$@"
  call -X POST "$me/leave"
  ;;
help | -h | --help) usage ;;
*)
  usage >&2
  exit 1
  ;;
esac
