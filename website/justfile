# The site's own checks; the root's `just ci` adds the shared ones.
ci:
    pnpm exec tsc -p .
    pnpm build

# The site at localhost:5173. The account pages answer from made-up data with
# #demo in the address, since the account service is not served here.
dev:
    pnpm dev

# Builds the site and serves it at vibetogether.agentics.lwirth.com, from
# lwirth-cloud, whose serve.nix in dotcloud says how.
deploy: ci
    rsync -rlpt --delete --delay-updates --chmod=D755,F644 dist/ root@lwirth-cloud:/srv/vibetogether/
